    {
      "id": "ma4-01",
      "tipo": "dialogo",
      "hablanteId": "dora",
      "expresion": "neutral",
      "texto": "¿Otra vez tú? Así me gusta. Ya elegiste qué practicar. Yo, cuando quiero aprender algo, busco a alguien a quien le salga bien y lo miro."
    },
    {
      "id": "ma4-02",
      "tipo": "dialogo",
      "hablanteId": "dora",
      "texto": "Para lo mío, escuchar sin interrumpir, miro a Sol, la de la biblioteca. ¿Sabes qué hace? Espera. Terminas de hablar, deja pasar un momento y recién contesta. Yo ya estaría en la tercera frase."
    },
    {
      "id": "ma4-03",
      "tipo": "dialogo",
      "hablanteId": "dora",
      "texto": "Ahora dime tú."
    },
    {
      "id": "ma4-modelo",
      "tipo": "consigna",
      "hablanteId": "dora",
      "item": "ma4-modelo"
    },
    {
      "id": "ma4-04",
      "tipo": "dialogo",
      "hablanteId": "dora",
      "nuevoMomento": true,
      "texto": "Mirar a alguien no es copiarlo. Es saber cómo se ve cuando sale bien."
    }
  ],
  "recompensa": {
    "mensajeFin": "Ya sabes cómo se ve esa habilidad cuando sale bien."
  },
