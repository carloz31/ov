# Copiar a /opt/ov/ov_backend/.env en la instancia EC2 (nunca versionar el .env real).
# Endpoint, usuario y contraseña de RDS: consola de RDS > tu base > Conectividad.
DATABASE_URL=postgresql+psycopg://ov_admin:CONTRASENA@ENDPOINT-RDS.rds.amazonaws.com:5432/ov?sslmode=require
ENTORNO=produccion
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
# LLM (Claude Haiku): registros, guion de Investigaciones y pasos del plan. Sin clave, se usan los respaldos.
ANTHROPIC_API_KEY=
