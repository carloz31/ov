# Preparar la base con Alembic y cargar plataforma o piloto mediante datos.cargar.
# El conjunto se carga manualmente; la aplicación solo lee DATABASE_URL.
# Las rutas SQLite relativas se resuelven desde la raíz del repositorio.
DATABASE_URL=sqlite:///ov.db
# PostgreSQL requiere uv sync --extra postgres y una base disponible.
# DATABASE_URL=postgresql+psycopg://ov:ov@localhost:5432/ov
# POST /desarrollo/reiniciar solo se incluye en ENTORNO=desarrollo.
ENTORNO=desarrollo
# Firma de los tokens de sesión (B17). Obligatorio en produccion, de al menos 32 caracteres.
# En desarrollo, si falta, se usa uno fijo.
JWT_SECRETO=
# Las pruebas usan siempre falso; Gemini requiere autorización explícita.
EVALUADOR=falso
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
GEMINI_TIMEOUT_SEGUNDOS=8
